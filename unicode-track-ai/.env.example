# ==============================================================================
# UniCodeTrack AI — Environment Variables Template
# ==============================================================================
# Copy this file to .env.local and populate with your real project keys.
# NEVER commit your actual .env.local file with real API keys to GitHub!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Authentication Configuration
# ------------------------------------------------------------------------------
# In your Supabase Dashboard: Go to Project Settings -> API
# - NEXT_PUBLIC_SUPABASE_URL: Found under "Project URL" (e.g. https://your-project-id.supabase.co)
# - NEXT_PUBLIC_SUPABASE_ANON_KEY: Found under "Project API keys" -> "anon public"
# - SUPABASE_SERVICE_ROLE_KEY: Found under "Project API keys" -> "service_role" (KEEP SECRET!)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Required for:
# - Capstone project requirements generation
# - Student group & team extraction from uploaded PDF
# - AI Code reviews & Rubric-based project grading
# - ER Diagram analysis & database implementation consistency checks
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_GENAI_API_KEY=your-gemini-api-key

# ------------------------------------------------------------------------------
# 3. GitHub API & Telemetry Configuration (Optional for Public Repos)
# ------------------------------------------------------------------------------
# GitHub Personal Access Token (classic or fine-grained) with 'repo' scope
# Used to fetch live commits, branches, pull requests, and file trees
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your-github-personal-access-token

# GitHub OAuth credentials (if using GitHub Login or webhooks)
# Register at: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. Application Host & Runtime Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
